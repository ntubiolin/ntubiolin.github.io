---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCVData } from '../utils/data';
import { formatText } from '../utils/format';

const cv = getCVData();
---

<BaseLayout title="About | YuSheng Lin">
	<div class="max-w-3xl mx-auto space-y-12">
		<section>
			<h1 class="text-4xl font-bold mb-6">About Me</h1>
			<div class="prose dark:prose-invert max-w-none text-lg" set:html={cv.about} />
		</section>

		<section>
			<h2 class="text-2xl font-bold mb-6">Experience</h2>
			<div class="space-y-8">
				{cv.positions.map(pos => (
					<div class="border-l-2 border-slate-200 dark:border-slate-800 pl-6 relative">
                        <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-slate-200 dark:bg-slate-800 border-4 border-white dark:border-slate-900"></div>
						<h3 class="text-xl font-bold">{pos.title}</h3>
						<div class="text-slate-600 dark:text-slate-400 mb-2">
							<span class="font-medium text-slate-900 dark:text-slate-100">{pos.place}</span>
                            {pos.location && <span> • {pos.location}</span>}
						</div>
						<div class="text-sm text-slate-500 mb-2">{pos.dates}</div>
                        {pos.inline_detail && (
                            <div class="text-slate-700 dark:text-slate-300" set:html={formatText(pos.inline_detail)} />
                        )}
						{pos.details && (
							<ul class="list-disc list-outside ml-4 mt-2 text-slate-700 dark:text-slate-300 space-y-1">
								{pos.details.map(detail => (
									<li set:html={formatText(detail)} />
								))}
							</ul>
						)}
					</div>
				))}
			</div>
		</section>

		<section>
			<h2 class="text-2xl font-bold mb-6">Education</h2>
			<div class="space-y-8">
				{cv.education.map(edu => (
					<div class="border-l-2 border-slate-200 dark:border-slate-800 pl-6 relative">
                        <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-slate-200 dark:bg-slate-800 border-4 border-white dark:border-slate-900"></div>
						<h3 class="text-xl font-bold">{edu.school}</h3>
						<div class="text-slate-600 dark:text-slate-400 mb-2">
							<span class="font-medium text-slate-900 dark:text-slate-100">{edu.degree}</span>
                            {edu.location && <span> • {edu.location}</span>}
						</div>
						<div class="text-sm text-slate-500 mb-2">{edu.dates}</div>
						{edu.details && (
							<ul class="list-disc list-outside ml-4 mt-2 text-slate-700 dark:text-slate-300 space-y-1">
								{edu.details.map(detail => (
									<li set:html={formatText(detail)} />
								))}
							</ul>
						)}
					</div>
				))}
			</div>
		</section>

        {cv.honors && (
            <section>
                <h2 class="text-2xl font-bold mb-6">Honors & Awards</h2>
                <div class="grid gap-4">
                    {cv.honors.map(honor => (
                        <div class="flex justify-between items-start border-b border-slate-100 dark:border-slate-800 pb-4 last:border-0">
                            <div>
                                <h3 class="font-bold">
                                    {honor.url ? (
                                        <a href={honor.url} target="_blank" class="hover:text-blue-600 transition-colors">{honor.title}</a>
                                    ) : honor.title}
                                </h3>
                                {honor.descr && <p class="text-sm text-slate-600 dark:text-slate-400 mt-1 whitespace-pre-line">{honor.descr}</p>}
                            </div>
                            <span class="text-sm text-slate-500 flex-shrink-0 ml-4">{honor.year}</span>
                        </div>
                    ))}
                </div>
            </section>
        )}
	</div>
</BaseLayout>
