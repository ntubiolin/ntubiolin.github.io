---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCVData, getPublications } from '../utils/data';

const cv = getCVData();
const publications = getPublications();

// Get recent publications (first 3)
// Assuming bibtex is sorted or we sort it. 
// The original generate.py sorted by year.
const sortedPublications = publications.sort((a, b) => {
  return parseInt(b.entryTags.year) - parseInt(a.entryTags.year);
}).slice(0, 3);

const { name, about, social } = cv;
const fullName = `${name.first} ${name.last}`;
---

<BaseLayout title={fullName}>
	<section class="py-12 md:py-20">
		<div class="flex flex-col md:flex-row items-center md:items-start gap-8 md:gap-12">
			<div class="w-48 h-48 md:w-64 md:h-64 flex-shrink-0">
				<img 
					src="/images/me.jpg" 
					alt={fullName} 
					class="w-full h-full object-cover rounded-full shadow-lg border-4 border-white dark:border-slate-800"
                    onerror="this.src='https://via.placeholder.com/300'"
				/>
			</div>
			<div class="flex-1 text-center md:text-left">
				<h1 class="text-4xl md:text-5xl font-bold mb-4 bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-600">
					{fullName}
				</h1>
				<div class="prose dark:prose-invert max-w-none mb-6 text-lg text-slate-600 dark:text-slate-300" set:html={about} />
				
				<div class="flex flex-wrap justify-center md:justify-start gap-4">
					{social.github && (
						<a href={`https://github.com/${social.github}`} target="_blank" class="px-6 py-2 rounded-full bg-slate-900 text-white hover:bg-slate-700 transition-colors">
							GitHub
						</a>
					)}
					{social.google_scholar && (
						<a href={`https://scholar.google.com/citations?user=${social.google_scholar}`} target="_blank" class="px-6 py-2 rounded-full bg-blue-600 text-white hover:bg-blue-700 transition-colors">
							Google Scholar
						</a>
					)}
                    {social.linkedin && (
						<a href={`https://linkedin.com/in/${social.linkedin}`} target="_blank" class="px-6 py-2 rounded-full bg-blue-800 text-white hover:bg-blue-900 transition-colors">
							LinkedIn
						</a>
					)}
                    <a href={cv.pdf} target="_blank" class="px-6 py-2 rounded-full border-2 border-slate-900 dark:border-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                        CV (PDF)
                    </a>
				</div>
			</div>
		</div>
	</section>

	<section class="py-12 border-t border-slate-200 dark:border-slate-800">
		<div class="flex justify-between items-center mb-8">
			<h2 class="text-3xl font-bold">Recent Publications</h2>
			<a href="/publications" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 font-medium">
				View All &rarr;
			</a>
		</div>
		
		<div class="space-y-8">
			{sortedPublications.map(pub => (
				<div class="bg-white dark:bg-slate-900 p-6 rounded-xl shadow-sm border border-slate-100 dark:border-slate-800 hover:shadow-md transition-shadow">
					<h3 class="text-xl font-bold mb-2">
						<a href={pub.entryTags.url || '#'} target="_blank" class="hover:text-blue-600 transition-colors">
							{pub.entryTags.title}
						</a>
					</h3>
					<p class="text-slate-600 dark:text-slate-400 mb-2">{pub.entryTags.author}</p>
					<div class="flex flex-wrap gap-2 text-sm text-slate-500 dark:text-slate-500">
						<span class="bg-slate-100 dark:bg-slate-800 px-2 py-1 rounded">{pub.entryTags.booktitle || pub.entryTags.journal || 'Preprint'}</span>
						<span class="bg-slate-100 dark:bg-slate-800 px-2 py-1 rounded">{pub.entryTags.year}</span>
					</div>
				</div>
			))}
		</div>
	</section>
</BaseLayout>
